# Copy this file to infra/.env and change every value. infra/.env is git-ignored.
#   PowerShell:  Copy-Item infra\.env.example infra\.env

# Postgres superuser (only used by the init script and for admin access).
POSTGRES_PASSWORD=change-me-admin

# One login per service database (created by infra/postgres/init/01-create-databases.sh).
PLAYERS_DB_PASSWORD=change-me-players
RACE_DB_PASSWORD=change-me-race

# Shared HS256 signing key for JWTs. Must be at least 32 characters (256 bits).
# Generate one in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Grafana admin login (user "admin"). Viewing dashboards needs no login.
GRAFANA_ADMIN_PASSWORD=change-me-grafana
